NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-api-key
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_MAPS_PLACE_ID=your-google-maps-place-id

# Optional: enables automatic WhatsApp notification from a separate Meta Cloud API sender.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_NOTIFICATION_TO=your-phone-number
WHATSAPP_GRAPH_API_VERSION=v23.0

# Firebase Web SDK (public project identifiers; still restrict data with Security Rules).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_DATABASE_URL=your-firebase-database-url
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Server-only administration and AI keys.
ADMINS_EMAIL=your_Admin_Emails
ADMIN_ALLOW_UNVERIFIED_EMAILS=your-unverified-email
GEMINI_API_KEY=your-gemini-api-key
# Gemini FREE-TIER role routing.
# The app chooses a role from the user request; it does NOT send every request to the strongest model.
# Lite: routing, extraction, short summaries, lightweight requests.
GEMINI_PREFLIGHT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODELS_LITE=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Standard: ordinary legal Q&A and normal drafting.
GEMINI_MODELS_STANDARD=gemini-3.5-flash,gemini-3.5-flash-lite

# Complex: multiple legal issues/documents. 3.5 Flash is tried before 3.6.
GEMINI_MODELS_COMPLEX=gemini-3.5-flash,gemini-3.6-flash

# Deep: constitutional/deep research/loophole analysis/complex case solving only.
GEMINI_MODELS_DEEP=gemini-3.6-flash,gemini-3.5-flash

# Conservative pacing guard for free-tier projects. All non-Lite Flash models share one lane,
# so their combined start rate stays below roughly 9 requests/minute per warm instance.
GEMINI_FLASH_MIN_INTERVAL_MS=7000
GEMINI_FLASH_LITE_MIN_INTERVAL_MS=4500
GEMINI_GLOBAL_MIN_INTERVAL_MS=2000
GEMINI_PREFLIGHT_MAX_ATTEMPTS=3
GEMINI_FINAL_MAX_ATTEMPTS=4
GEMINI_EMPTY_RESPONSE_MAX_ATTEMPTS=2
GEMINI_RETRY_BASE_MS=2500
GEMINI_RETRY_MAX_MS=30000

# Hybrid Case RAG — one Gemini Embedding 2 request per user query. Unchanged case vectors
# are cached in each warm server instance, so only the query + missing/changed cases are embedded.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_MIN_INTERVAL_MS=1200
GEMINI_EMBEDDING_MAX_ATTEMPTS=3
GEMINI_EMBEDDING_RETRY_BASE_MS=1500
GEMINI_EMBEDDING_RETRY_MAX_MS=12000
CASE_RAG_MAX_EMBED_CANDIDATES=64
# Demo/training cases are excluded from real legal retrieval unless the query explicitly asks for demo data.
CASE_RAG_INCLUDE_DEMO=false
# Strict hybrid gate: either very high semantic similarity, or strong semantic similarity + >=2 lexical legal anchors.
CASE_RAG_MIN_COMBINED_SCORE=60
CASE_RAG_HIGH_SEMANTIC_SCORE=0.78
CASE_RAG_SUPPORTED_SEMANTIC_SCORE=0.70
CASE_RAG_MIN_LEXICAL_TERMS=2

# Legal Quality Gate. Deterministic validation always runs without consuming a Gemini request.
# A Flash-Lite semantic verifier runs ONLY for complex/deep answers when the deterministic
# gate finds a severe grounding problem, protecting the free-tier request budget.
LEGAL_QUALITY_SEMANTIC_VERIFY=true
LEGAL_QUALITY_SEMANTIC_TRIGGER_SCORE=78
GEMINI_QUALITY_MODEL=gemini-3.5-flash-lite

# Optional hard overrides. Leave unset to let workload policy choose.
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_MAX_CONTINUATIONS=1

# Legacy 2.5 models are intentionally NOT defaults: some new projects return 404 and current
# free-tier availability differs from older quota sheets. Add them only to a role list if AI Studio
# confirms that your own project has free access to them.

# Bahrain Legal News / Government Intelligence
# BNA provides a free RSS service. Leave BNA_RSS_URLS empty to let the app discover feeds from the RSS index page.
# Bahrain Legal News / Government Intelligence
BNA_RSS_INDEX_URL=https://beta.bna.bh/rss
BNA_RSS_URLS=
BAHRAIN_LEGAL_AFFAIRS_URL=https://www.legalaffairs.gov.bh/
LEGAL_NEWS_CACHE_SECONDS=1800
LEGAL_NEWS_MAX_ITEMS=18
LEGAL_NEWS_TAVILY_FALLBACK=true

# Local press sources. Leave blank to use the built-in official/public endpoints below.
ALWATAN_RSS_URLS=https://alwatannews.net/rssFeed/0,https://alwatannews.net/rssFeed/100,https://alwatannews.net/rssFeed/135/112
ALAYAM_RSS_URLS=https://feeds.feedburner.com/alayam-news-list-all,https://feeds.feedburner.com/alayam-online-local-news,https://feeds.feedburner.com/alayam-daily-local-news
ALAYAM_HTML_URLS=https://www.alayam.com/alayam/Courts
ALBILAD_RSS_URLS=https://www.albiladpress.com/rss
ALBILAD_HTML_URLS=https://www.albiladpress.com/latest-news,https://www.albiladpress.com/news/bahrain
AKHBAR_ALKHALEEJ_URLS=https://akhbar-alkhaleej.com/news/section/EVNT,https://akhbar-alkhaleej.com/news/section/BNEW
GDN_URLS=https://www.gdnonline.com/Section/1/Bahrain
DAILY_TRIBUNE_URLS=https://www.newsofbahrain.com/bahrain/


# Tavily is used only as a fallback/enrichment source for the legal-news collector and normal Agent web research.
# Public news rendering itself does NOT call Gemini.
# ============================================================
# خوادم MCP — يجب أن تبقى القيمة JSON في سطر واحد.
# Tavily يعمل كخادم MCP بعيد ومتوافق مع Vercel.
# ============================================================
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_DEFAULT_PARAMETERS='{"include_images":true,"max_results":15,"search_depth":"advanced"}'


# v22 legal-quality behavior uses the existing verifier controls above.
# Complex/deep requests with critical official judgment anchors may invoke one Flash-Lite QA pass.
