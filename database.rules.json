{
  "rules": {
    ".read": false,
    ".write": false,
    "cases": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'alromaihi2224@gmail.com' || auth.token.email == 'alromaihi2225@gmail.com')",
      ".indexOn": ["updatedAt", "caseYear", "status"],
      "$caseId": {
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'alromaihi2224@gmail.com' || auth.token.email == 'alromaihi2225@gmail.com')",
        ".validate": "newData.hasChildren(['caseNumber','caseYear','caseType','clientName','accusedName','victimName','court','status','judgment','judgeName','notes','nextHearing','isDemo','createdAt','updatedAt','createdBy'])",
        "caseNumber": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "caseYear": { ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2200" },
        "caseType": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "clientName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 160" },
        "accusedName": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "victimName": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "court": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 160" },
        "status": { ".validate": "newData.isString() && (newData.val() == 'new' || newData.val() == 'active' || newData.val() == 'hearing' || newData.val() == 'judgment' || newData.val() == 'execution' || newData.val() == 'closed')" },
        "judgment": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "judgeName": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "nextHearing": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "isDemo": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "createdBy": { ".validate": "newData.isString() && ((!data.exists() && newData.val() == auth.uid) || (data.exists() && newData.val() == data.val()))" },
        "$other": { ".validate": false }
      }
    },
    "adminPresence": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'alromaihi2224@gmail.com' || auth.token.email == 'alromaihi2225@gmail.com')",
        ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true && (auth.token.email == 'alromaihi2224@gmail.com' || auth.token.email == 'alromaihi2225@gmail.com')",
        ".validate": "newData.hasChildren(['online','lastSeen','email'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "email": { ".validate": "newData.isString() && newData.val() == auth.token.email" },
        "$other": { ".validate": false }
      }
    }
  }
}
