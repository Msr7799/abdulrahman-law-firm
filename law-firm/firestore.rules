rules_version = '2';

// ===============================================================
// Assumed data model (prototype)
// ===============================================================
// contacts/{contactId}: category, nameAr, nameEn, phone, notesAr,
// notesEn, sourceUrl, verifiedAt, sortOrder, createdAt, updatedAt,
// createdBy. All fields are required and admin-only.
// auditLogs/{logId}: action, entityType, entityId, summary, createdBy,
// createdAt. Immutable, append-only and admin-only.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          (request.auth.token.email_verified == true
            && request.auth.token.email in [
              'alromaihi2224@gmail.com',
              'alromaihi2225@gmail.com'
            ])
          || request.auth.token.email == 'alm3wdah@icloud.com'
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(data) {
      return !('uid' in data) || data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function validString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validUrl(value) {
      return validString(value, 8, 500)
        && value.matches('^https://.*');
    }

    function isValidContact(data) {
      return data.keys().hasAll([
          'category', 'nameAr', 'nameEn', 'phone', 'notesAr', 'notesEn',
          'sourceUrl', 'verifiedAt', 'sortOrder', 'createdAt', 'updatedAt',
          'createdBy'
        ])
        && data.keys().hasOnly([
          'category', 'nameAr', 'nameEn', 'phone', 'notesAr', 'notesEn',
          'sourceUrl', 'verifiedAt', 'sortOrder', 'createdAt', 'updatedAt',
          'createdBy'
        ])
        && validString(data.category, 2, 40)
        && validString(data.nameAr, 2, 160)
        && validString(data.nameEn, 2, 160)
        && validString(data.phone, 0, 80)
        && validString(data.notesAr, 0, 500)
        && validString(data.notesEn, 0, 500)
        && validUrl(data.sourceUrl)
        && validString(data.verifiedAt, 10, 10)
        && data.verifiedAt.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validString(data.createdBy, 10, 128);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'action', 'entityType', 'entityId', 'summary', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'action', 'entityType', 'entityId', 'summary', 'createdBy', 'createdAt'
        ])
        && data.action in ['create', 'update', 'delete', 'import', 'seed', 'ai_query']
        && validString(data.entityType, 2, 40)
        && validString(data.entityId, 1, 160)
        && validString(data.summary, 1, 500)
        && validString(data.createdBy, 10, 128)
        && data.createdAt is timestamp;
    }

    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidContact(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && isValidContact(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidAuditLog(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
